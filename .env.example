APP_ENV=development
APP_NAME=gdrive-rag-accounting-bot
LOG_LEVEL=INFO
API_KEY=change-me
INTERNAL_API_URL=http://localhost:8000

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_HOST_PORT=5433
POSTGRES_DB=ragbot
POSTGRES_USER=ragbot
POSTGRES_PASSWORD=change-me
DATABASE_URL=

REDIS_URL=redis://localhost:6379/0
REDIS_HOST_PORT=6379

TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs; @usernames are intentionally unsupported.
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ADMIN_USER_IDS=
# Optional UUID. An empty value means that no default tenant is configured yet.
TELEGRAM_DEFAULT_TENANT_ID=

GOOGLE_AUTH_MODE=service_account
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google-service-account.json
GOOGLE_OAUTH_CLIENT_FILE=credentials/google-oauth-client.json
GOOGLE_OAUTH_TOKEN_FILE=credentials/google-oauth-token.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-flash-latest
AI_EXTERNAL_PROCESSING_ENABLED=true

PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_HOST=
PINECONE_NAMESPACE_PREFIX=ragbot
PINECONE_CLOUD=aws
PINECONE_REGION=eu-west-1
PINECONE_METRIC=cosine
PINECONE_STORAGE_WARNING_MB=1500

EMBEDDING_PROVIDER=local_qwen
EMBEDDING_HTTP_URL=
EMBEDDING_HTTP_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_LENGTH=8192
CACHE_DIR=/tmp/ragbot-cache

CHUNK_TARGET_TOKENS=700
CHUNK_OVERLAP_TOKENS=80
MAX_CHUNKS_PER_DOCUMENT=2000

TOP_K_SEMANTIC=20
TOP_K_LEXICAL=20
TOP_K_RERANK=8
MIN_RELEVANCE_SCORE=0.05

OCR_ENABLED=false
OCR_PROVIDER=tesseract
OCR_LANGUAGES=deu+eng
OCR_MIN_TEXT_CHARS=80

MAX_FILE_SIZE_MB=100
SYNC_POLL_INTERVAL_SECONDS=300
INITIAL_SYNC_DRY_RUN=true

AGENT_MAX_ITERATIONS=4
AGENT_MAX_TOOL_CALLS=8
AGENT_TIMEOUT_SECONDS=45
